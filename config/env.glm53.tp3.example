# env.glm53.tp3.example — 3× DGX Spark TP=3 settings for start.sh
#
# Copy the values you need into your shell (or a sourced env file) before
# running ./start.sh. Everything has a sane default for a 3-Spark kit; the
# ones you MUST look at are the worker addresses and the CX7 pins.
#
# --- topology ---------------------------------------------------------------
# The technique: GLM-5.3-Flash has 64 MLA heads and 64 KDA heads; 64 % 3 != 0,
# so patches/tp3/apply_tp3_patch.py pads heads 64->66, the MoE intermediate
# 2048->2112 and the vocab 154880->154944, with zeroed pad slabs that
# contribute exactly nothing. Unpatched, TP=3 dies at config validation
# ("Total number of attention heads (64) must be divisible ...").
TP=3
N_WORKERS=2

HEAD_IP=10.0.0.1                    # this machine, as the workers reach it

WORKER1_SSH=user@10.0.0.2           # second Spark
WORKER1_IP=10.0.0.2
WORKER1_HOME=/home/user
WORKER2_SSH=user@10.0.0.3           # third Spark
WORKER2_IP=10.0.0.3
WORKER2_HOME=/home/user

# --- fabric -----------------------------------------------------------------
# NCCL cannot use IP aliases — pin the CX7 interface + RDMA device per node.
# On a SWITCHED fabric every node pins its switch-facing port. On a triangle
# of direct QSFP links, pin the port that faces the HEAD. (This was developed
# on a 100G RoCE switch; the launcher is fabric-agnostic.)
HEAD_CX7_IF=enp1s0f1np1
HEAD_CX7_IB=rocep1s0f1
WORKER1_CX7_IF=enp1s0f0np0
WORKER1_CX7_IB=rocep1s0f0
WORKER2_CX7_IF=enp1s0f0np0
WORKER2_CX7_IB=rocep1s0f0
NCCL_IB_GID_INDEX=3                 # RoCEv2 GID; check `show_gids` on your kit

# --- model ------------------------------------------------------------------
# Default is the checkpoint the 2-node recipe pins. Geometry-identical
# derivatives work too (the patch keys on shapes, not weights):
#MODEL=dealignai/GLM-5.3-Flash-UNCENSORED-NVFP4
# ⚠ For derivative checkpoints, point the chat-template refresh at the BASE
# model — quantizers snapshot their base repo and can ship a stale template
# (the launcher refuses one without emit_image):
#CHAT_TEMPLATE_URL=https://huggingface.co/zai-org/GLM-5.3-Flash/resolve/main/chat_template.jinja
# Optional for production/offline restarts after the template has already been
# refreshed once. The launcher still refuses a cached template missing emit_image.
#SKIP_TEMPLATE_REFRESH=1

# --- serving profile (MiaAI's, unchanged) -----------------------------------
MOE_BACKEND=marlin                  # GB10-known-good; `auto` tries native first
MTP_TOKENS=4                        # MTP speculative decode
MAX_MODEL_LEN=262144                # checkpoint is 1M-native; TP=3 has KV room
GPU_MEM_UTIL=0.80                   # UMA discipline; higher can trip Ray's node-memory monitor
KV_CACHE_DTYPE=fp8_e4m3
BLOCK_SIZE=2304
ENFORCE_EAGER=1
RAY_memory_usage_threshold=0.99     # GB10 UMA: avoid Ray killing the vLLM actor at 95%

# --- vision under TP=3 ------------------------------------------------------
# The ViT has 16 heads; 16 % 3 != 0. Run the multimodal encoder
# data-parallel (replicated per rank, ~0.9 GiB) instead of sharding it.
MM_ENCODER_TP_MODE=data

# --- throughput -------------------------------------------------------------
# ⭐ If you change one thing, change this. The 2-node recipe ships 8, and on
# the DSv4 TP=3 cluster the same knob (not the hardware) was what capped
# aggregate throughput (238 -> 618 tok/s going 6 -> 32). At TP=3 the KV pool
# is ~3x the dual kit's — sweep 16/32 with scripts/benchmark_tp3.py and keep
# what your headroom sustains.
MAX_NUM_SEQS=8

# --- patch ------------------------------------------------------------------
TP3_PATCH=1                         # 0 only for TP=1/2/4 (divisible shapes)
#VLLM_GLM53_TP_PAD_ALIGN8=1         # pad heads 64->72 (24/rank, %8) instead of
                                    # 66 (22/rank) if a kernel objects to 22.
                                    # Costs ~12% extra attention compute.
